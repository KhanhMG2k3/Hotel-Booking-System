# MySQL Database Configuration for Sogo Homestay Booking
# Copy this file to db.properties and fill in your credentials
db.driver=com.mysql.cj.jdbc.Driver
db.url=jdbc:mysql://localhost:3306/homestaybooking?useSSL=false&allowPublicKeyRetrieval=true&useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC
db.user=root
db.password=YOUR_PASSWORD_HERE
db.maxPoolSize=10
