<?xml version="1.0" encoding="UTF-8"?>

<web-app
    xmlns="https://jakarta.ee/xml/ns/jakartaee"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        https://jakarta.ee/xml/ns/jakartaee
        https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
    version="6.0">

    <display-name>Sogo Homestay Booking System</display-name>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Payment Webhook & Polling Servlets -->
    <servlet>
        <servlet-name>PaymentStatusServlet</servlet-name>
        <servlet-class>com.homestay.controller.api.PaymentStatusServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PaymentStatusServlet</servlet-name>
        <url-pattern>/api/payment/status</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SePayWebhookServlet</servlet-name>
        <servlet-class>com.homestay.controller.api.SePayWebhookServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SePayWebhookServlet</servlet-name>
        <url-pattern>/api/payment/webhook</url-pattern>
        <url-pattern>/api/webhook/sepay</url-pattern>
    </servlet-mapping>

</web-app>
