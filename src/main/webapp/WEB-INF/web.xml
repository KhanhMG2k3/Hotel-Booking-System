<?xml version="1.0" encoding="UTF-8"?>
<web-app version="6.0" xmlns="https://jakarta.ee/xml/ns/jakartaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd">
    <display-name>Sogo Homestay Booking System</display-name>
    <!-- Enforce UTF-8 Character Encoding for all incoming requests and outgoing responses -->
    <filter>
        <filter-name>EncodingFilter</filter-name>
        <filter-class>com.homestay.filter.EncodingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>EncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
        <dispatcher>FORWARD</dispatcher>
    </filter-mapping>

    <!-- Enforce Vietnam TimeZone (UTC+7) for all JSTL fmt formatting -->
    <context-param>
        <param-name>jakarta.servlet.jsp.jstl.fmt.timeZone</param-name>
        <param-value>Asia/Ho_Chi_Minh</param-value>
    </context-param>

    <!-- Provide a session-bound logout CSRF token to authenticated requests. -->
    <filter>
        <filter-name>LogoutCsrfFilter</filter-name>
        <filter-class>com.homestay.filter.LogoutCsrfFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>LogoutCsrfFilter</filter-name>
        <url-pattern>/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
        <dispatcher>FORWARD</dispatcher>
    </filter-mapping>

    <!-- Forward the application root to the public homepage JSP. -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- MIME type mappings enforcing UTF-8 charset -->
    <mime-mapping>
        <extension>js</extension>
        <mime-type>application/javascript;charset=UTF-8</mime-type>
    </mime-mapping>
    <mime-mapping>
        <extension>css</extension>
        <mime-type>text/css;charset=UTF-8</mime-type>
    </mime-mapping>
    <mime-mapping>
        <extension>json</extension>
        <mime-type>application/json;charset=UTF-8</mime-type>
    </mime-mapping>
    <mime-mapping>
        <extension>html</extension>
        <mime-type>text/html;charset=UTF-8</mime-type>
    </mime-mapping>
    <mime-mapping>
        <extension>svg</extension>
        <mime-type>image/svg+xml;charset=UTF-8</mime-type>
    </mime-mapping>

    <!-- Map static pages -->
    <servlet>
        <servlet-name>AboutController</servlet-name>
        <servlet-class>com.homestay.controller.AboutController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AboutController</servlet-name>
        <url-pattern>/about</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>TermsController</servlet-name>
        <servlet-class>com.homestay.controller.TermsController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TermsController</servlet-name>
        <url-pattern>/terms</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>FaqController</servlet-name>
        <servlet-class>com.homestay.controller.FaqController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FaqController</servlet-name>
        <url-pattern>/faq</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ContactController</servlet-name>
        <servlet-class>com.homestay.controller.ContactController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ContactController</servlet-name>
        <url-pattern>/contact</url-pattern>
        <url-pattern>/contact-us</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SupportController</servlet-name>
        <servlet-class>com.homestay.controller.SupportController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SupportController</servlet-name>
        <url-pattern>/support/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminSupportController</servlet-name>
        <servlet-class>com.homestay.controller.AdminSupportController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminSupportController</servlet-name>
        <url-pattern>/admin/support</url-pattern>
        <url-pattern>/admin/support/*</url-pattern>
    </servlet-mapping>

    <!-- Map account pages and authentication actions to their controllers. -->
    <servlet>
        <servlet-name>LoginController</servlet-name>
        <servlet-class>com.homestay.controller.LoginController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginController</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>GoogleLoginController</servlet-name>
        <servlet-class>com.homestay.controller.GoogleLoginController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>GoogleLoginController</servlet-name>
        <url-pattern>/login/google</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RegisterController</servlet-name>
        <servlet-class>com.homestay.controller.RegisterController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterController</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ForgotPasswordController</servlet-name>
        <servlet-class>com.homestay.controller.ForgotPasswordController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ForgotPasswordController</servlet-name>
        <url-pattern>/forgot-password</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ResetPasswordController</servlet-name>
        <servlet-class>com.homestay.controller.ResetPasswordController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ResetPasswordController</servlet-name>
        <url-pattern>/reset-password</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>VerifyOtpController</servlet-name>
        <servlet-class>com.homestay.controller.VerifyOtpController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>VerifyOtpController</servlet-name>
        <url-pattern>/verify-otp</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ProfileController</servlet-name>
        <servlet-class>com.homestay.controller.ProfileController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProfileController</servlet-name>
        <url-pattern>/profile</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutController</servlet-name>
        <servlet-class>com.homestay.controller.LogoutController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutController</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>MyBookingsController</servlet-name>
        <servlet-class>com.homestay.controller.MyBookingsController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MyBookingsController</servlet-name>
        <url-pattern>/my-bookings</url-pattern>
        <url-pattern>/my-bookings/*</url-pattern>
    </servlet-mapping>

    <!-- Map Host and administrator pages and APIs to their controllers. -->
    <servlet>
        <servlet-name>HostApplicationController</servlet-name>
        <servlet-class>com.homestay.controller.HostApplicationController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HostApplicationController</servlet-name>
        <url-pattern>/become-host</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>HostDashboardController</servlet-name>
        <servlet-class>com.homestay.controller.HostDashboardController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HostDashboardController</servlet-name>
        <url-pattern>/host/dashboard</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>HostCalendarController</servlet-name>
        <servlet-class>com.homestay.controller.HostCalendarController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HostCalendarController</servlet-name>
        <url-pattern>/host/calendar</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>HostPropertyApiController</servlet-name>
        <servlet-class>com.homestay.controller.HostPropertyApiController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HostPropertyApiController</servlet-name>
        <url-pattern>/api/host/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminHostApplicationsController</servlet-name>
        <servlet-class>com.homestay.controller.AdminHostApplicationsController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminHostApplicationsController</servlet-name>
        <url-pattern>/admin/host-applications</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PartnerApplicationApiController</servlet-name>
        <servlet-class>com.homestay.controller.PartnerApplicationApiController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PartnerApplicationApiController</servlet-name>
        <url-pattern>/api/partner-applications/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminPartnerApplicationsApiController</servlet-name>
        <servlet-class>com.homestay.controller.AdminPartnerApplicationsApiController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminPartnerApplicationsApiController</servlet-name>
        <url-pattern>/api/admin/partner-applications/*</url-pattern>
    </servlet-mapping>

    <!-- Global JSP Configuration: Enforce UTF-8 for all JSP pages -->


    <!-- Payment Webhook & Polling Servlets -->
    <servlet>
        <servlet-name>PaymentStatusServlet</servlet-name>
        <servlet-class>com.homestay.controller.api.PaymentStatusServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PaymentStatusServlet</servlet-name>
        <url-pattern>/api/payment/status</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SePayWebhookServlet</servlet-name>
        <servlet-class>com.homestay.controller.api.SePayWebhookServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SePayWebhookServlet</servlet-name>
        <url-pattern>/api/payment/webhook</url-pattern>
        <url-pattern>/api/webhook/sepay</url-pattern>
    </servlet-mapping>

    <!-- JSP Servlet with explicit UTF-8 encoding -->
    <servlet>
        <servlet-name>jsp</servlet-name>
        <servlet-class>org.apache.jasper.servlet.JspServlet</servlet-class>
        <init-param>
            <param-name>fork</param-name>
            <param-value>false</param-value>
        </init-param>
        <init-param>
            <param-name>xpoweredBy</param-name>
            <param-value>false</param-value>
        </init-param>
        <init-param>
            <param-name>javaEncoding</param-name>
            <param-value>UTF-8</param-value>
        </init-param>
        <load-on-startup>3</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>jsp</servlet-name>
        <url-pattern>*.jsp</url-pattern>
        <url-pattern>*.jspx</url-pattern>
    </servlet-mapping>

    <jsp-config>
        <jsp-property-group>
            <url-pattern>*.jsp</url-pattern>
            <page-encoding>UTF-8</page-encoding>
            <trim-directive-whitespaces>true</trim-directive-whitespaces>
            <default-content-type>text/html; charset=UTF-8</default-content-type>
        </jsp-property-group>
    </jsp-config>
</web-app>
